generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  NEW
  ACCEPTED
  ON_WAY
  DONE
  CANCELLED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum PaymentType {
  CASH
  CARD
}

model User {
  id          Int      @id @default(autoincrement())
  telegramId  String   @unique
  firstName   String
  lastName    String?
  username    String?
  phone       String?
  lastAddress String?
  lastLat     Float?
  lastLon     Float?
  // Til: "uz" | "ru" (null — hali tanlanmagan)
  lang        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
  favorites   Favorite[]
  reviews     Review[]
}

model Category {
  id        Int       @id @default(autoincrement())
  nameUz    String
  nameRu    String    @default("")
  imageUrl  String    @default("")
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id            Int        @id @default(autoincrement())
  // name/description/ingredients — o'zbekcha, *Ru — ruscha
  name          String
  nameRu        String     @default("")
  description   String     @default("")
  descriptionRu String     @default("")
  ingredients   String[]   @default([])
  ingredientsRu String[]   @default([])
  imageUrl      String     @default("")
  oldPrice      Int?
  price         Int
  categoryId    Int?
  category      Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isHit         Boolean    @default(false)
  isActive      Boolean    @default(true)
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  favorites     Favorite[]

  @@index([isActive, categoryId])
}

model Favorite {
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  text      String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Order {
  id           Int          @id @default(autoincrement())
  clientRef    String?      @unique
  userId       Int
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        Json
  subtotal     Int
  deliveryFee  Int          @default(0)
  total        Int
  deliveryType DeliveryType
  paymentType  PaymentType
  customerName String
  phone        String
  address      String?
  addressNote  String?
  lat          Float?
  lon          Float?
  comment      String?
  status       OrderStatus  @default(NEW)
  printedAt    DateTime?
  receiptFileId String?
  receiptType  String?
  receiptAt    DateTime?
  receiptConfirmedAt DateTime?
  branchId     Int?
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Settings {
  id               Int      @id @default(1)
  cards            Json     @default("[]")
  deliveryFee      Int      @default(0) // ishlatilmaydi — yetkazish narxi buyurtmaga qo'shilmaydi
  freeDeliveryFrom Int      @default(0) // ishlatilmaydi — bepul yetkazish yo'q
  minOrder         Int      @default(50000)
  pickupAddress    String   @default("Toshkent, Foziltepa ko'chasi, 40")
  contactPhone     String   @default("")
  // Filial nuqtasi: Yandex Go'da "Qayerdan" maydoni uchun
  shopLat          Float?
  shopLon          Float?
  isOpen           Boolean  @default(true)
  workHours        String   @default("10:00 – 02:00")
  instagram        String   @default("")
  aboutUz          String   @default("")
  aboutRu          String   @default("")
  // Boshlang'ich ma'lumotlar versiyasi (seed bir marta ishlashi uchun)
  seedVersion      Int      @default(0)
  // Oshxona cheki: OFF | NEW (yangi buyurtma kelganda) | ACCEPTED ("Qabul qilish" bosilganda)
  printMode        String   @default("NEW")
  printerIp        String   @default("")
  paperWidth       Int      @default(80)
  printCopies      Int      @default(1)
  updatedAt        DateTime @updatedAt
}

// Yuklangan rasmlar bazada saqlanadi (bepul serverlarda disk vaqtinchalik)
model Upload {
  id        String   @id
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

// Olib ketish filiallari
model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  nameRu    String   @default("")
  address   String
  lat       Float?
  lon       Float?
  phone     String   @default("")
  workHours String   @default("")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
