# Bu fayl namuna. "npm run setup" buyrug'i haqiqiy .env faylini o'zi yaratadi.

# Neon -> Connect -> Connection string (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Xuddi shu manzil, faqat "-pooler" so'zisiz (migratsiyalar uchun)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# BotFather bergan token
BOT_TOKEN=""
# Yangi buyurtmalar haqida xabar oladigan Telegram ID(lar), vergul bilan
ADMIN_IDS=""
# Admin panel paroli
ADMIN_PASSWORD=""
# Tokenlarni imzolash uchun tasodifiy matn
APP_SECRET=""

PORT=3000
# Bo'sh qoldirilsa, ngrok manzili avtomatik aniqlanadi (http://127.0.0.1:4040)
WEBAPP_URL=""
# Ixtiyoriy: Yandex Geocoder API kaliti (manzilni yanada aniqroq chiqaradi)
YANDEX_GEOCODER_KEY=""
# Faqat brauzerda sinash uchun (Telegramsiz). Haqiqiy ishda false bo'lsin.
ALLOW_DEV_USER=false
